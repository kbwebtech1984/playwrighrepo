pipeline {

    agent any

    tools {

        nodejs 'NodeJS26'

    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm

            }

        }

        stage('Install Dependencies') {

            steps {

                bat 'call npm install'

            }

        }

        stage('Install Browsers') {

            steps {

                bat 'call npx playwright install'

            }

        }

        stage('Run Playwright Tests') {

            steps {

                bat 'call npx playwright test demo2.spec.js --headed --project=chromium'
                bat 'call npx playwright test specother.spec.js --headed --project=chromium'

            }

        }

    }

}